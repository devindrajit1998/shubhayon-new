rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Main site data document — read publicly, write from the app
    match /content/site_data {
      allow read: if true;
      allow write: if true;
    }

    // Block all other documents by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
